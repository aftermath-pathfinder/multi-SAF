{
    "name": "aftermath-pathfinder/store-forward-mns",
    "description": "Alibaba Cloud MNS (Message Service) transport driver for aftermath-pathfinder/store-forward.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "store-and-forward", "alibaba", "mns"],
    "require": {
        "php": "^8.1",
        "aftermath-pathfinder/store-forward": "*@dev",
        "aliyun/aliyun-mns-php-sdk": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "AftermathPathfinder\\StoreForwardMns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AftermathPathfinder\\StoreForwardMns\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AftermathPathfinder\\StoreForwardMns\\MnsDriverServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {"type": "path", "url": "../../", "options": {"symlink": true}}
    ]
}
