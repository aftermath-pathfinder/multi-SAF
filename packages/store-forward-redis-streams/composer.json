{
    "name": "aftermath-pathfinder/store-forward-redis-streams",
    "description": "Self-hosted Redis Streams transport driver for aftermath-pathfinder/store-forward.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "store-and-forward", "redis", "redis-streams", "self-hosted"],
    "require": {
        "php": "^8.1",
        "aftermath-pathfinder/store-forward": "*@dev",
        "illuminate/redis": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "AftermathPathfinder\\StoreForwardRedisStreams\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AftermathPathfinder\\StoreForwardRedisStreams\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AftermathPathfinder\\StoreForwardRedisStreams\\RedisStreamsDriverServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {"type": "path", "url": "../../", "options": {"symlink": true}}
    ]
}
