{
    "name": "aftermath-pathfinder/store-forward-amqp",
    "description": "Self-hosted RabbitMQ (AMQP) transport driver for aftermath-pathfinder/store-forward.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "store-and-forward", "rabbitmq", "amqp", "self-hosted"],
    "require": {
        "php": "^8.1",
        "aftermath-pathfinder/store-forward": "*@dev",
        "php-amqplib/php-amqplib": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "AftermathPathfinder\\StoreForwardAmqp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AftermathPathfinder\\StoreForwardAmqp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AftermathPathfinder\\StoreForwardAmqp\\AmqpDriverServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {"type": "path", "url": "../../", "options": {"symlink": true}}
    ]
}
