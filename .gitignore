/vendor
/.phpunit.cache
/.phpunit.result.cache
composer.lock
.DS_Store

# Each package under packages/ is developed against a local path-repo
# dependency (see packages/README.md), so its vendor/ and lock file are
# throwaway/dev-machine-specific just like the root package's.
packages/*/vendor
packages/*/composer.lock
packages/*/.phpunit.cache
packages/*/.phpunit.result.cache
