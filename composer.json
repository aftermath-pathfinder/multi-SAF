{
    "name": "aftermath-pathfinder/store-forward",
    "description": "Transport-agnostic store-and-forward messaging for Laravel — one API over a durable local outbox, forwarding to Kafka, RabbitMQ, SQS, Redis Streams, or Laravel's own queue.",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/aftermath-pathfinder/multi-SAF/issues",
        "source": "https://github.com/aftermath-pathfinder/multi-SAF"
    },
    "keywords": [
        "laravel",
        "store-and-forward",
        "outbox",
        "kafka",
        "rabbitmq",
        "amqp",
        "sqs",
        "message-queue",
        "event-driven"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/queue": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "AftermathPathfinder\\StoreForward\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AftermathPathfinder\\StoreForward\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "AftermathPathfinder\\StoreForward\\StoreForwardServiceProvider"
            ],
            "aliases": {
                "StoreForward": "AftermathPathfinder\\StoreForward\\Facades\\StoreForward"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
